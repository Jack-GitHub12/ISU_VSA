# ISU VSA Website Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================
# Site Configuration
# ===========================
NEXT_PUBLIC_SITE_URL=https://isuvsa.org
NEXT_PUBLIC_CONTACT_EMAIL=info@isuvsa.org
NEXT_PUBLIC_DISCORD_URL=https://discord.com/invite/your-invite-code

# ===========================
# Admin Authentication
# ===========================
# IMPORTANT: Change this password immediately in production!
ADMIN_PASSWORD=your-secure-admin-password-here
# Consider using a strong password generator
# Example: openssl rand -base64 32

# ===========================
# Email Service (Resend)
# ===========================
# Sign up at https://resend.com to get an API key
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@isuvsa.org
# Optionally, set up a custom domain for sending

# ===========================
# Instagram Integration
# ===========================
# Facebook/Instagram Graph API credentials
# Follow the setup guide at https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id
# Optional: Business account token for more features
INSTAGRAM_BUSINESS_ACCOUNT_ID=optional_business_account_id

# ===========================
# Database (Supabase)
# ===========================
# Sign up at https://supabase.com to get these credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================
# Analytics & Monitoring (Optional)
# ===========================
# Vercel Analytics (automatic if deployed on Vercel)
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ===========================
# Feature Flags
# ===========================
NEXT_PUBLIC_ENABLE_REMOTE_LOGGING=false
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false

# ===========================
# Development Only
# ===========================
# These are only used in development mode
NEXT_PUBLIC_DEV_MODE=false

# ===========================
# API Rate Limiting (Optional)
# ===========================
# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ===========================
# Image Optimization (Optional)
# ===========================
# Cloudinary for image hosting and optimization
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================
# OAuth Providers (Future Enhancement)
# ===========================
# For future implementation of OAuth login
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ===========================
# Notes
# ===========================
# 1. Never commit .env.local to version control
# 2. Keep this .env.example file updated with all required variables
# 3. Use strong, unique passwords for all services
# 4. Rotate API keys and tokens regularly
# 5. Use different credentials for development, staging, and production
# 6. Consider using a secrets management service for production